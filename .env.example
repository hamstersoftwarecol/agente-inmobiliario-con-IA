# ─────────────────────────────────────────────────────────────
# InmoVoz · Recepcionista inmobiliaria con IA
# Copia este archivo a `.env` y completa los valores.
# ─────────────────────────────────────────────────────────────

# URL pública de la app (sin "/" final). Vapi y Stripe la usan para los webhooks.
# En local puedes exponerla con `ngrok http 3000` o `cloudflared tunnel`.
APP_URL=http://localhost:3000

# Base de datos PostgreSQL (docker compose up -d levanta una en local)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/inmovoz

# ── LLM (Claude / Anthropic) ─────────────────────────────────
# Cerebro del agente: conversación, herramientas y análisis de llamadas.
ANTHROPIC_API_KEY=
# Modelo para chat/voz y análisis. Por defecto: claude-opus-5-5
ANTHROPIC_MODEL=claude-opus-5-5
# (Opcional) Modelo distinto solo para llamadas de voz, si priorizas latencia.
ANTHROPIC_VOICE_MODEL=
# Esfuerzo de razonamiento: low | medium | high | xhigh | max
AI_CHAT_EFFORT=low
AI_ANALYSIS_EFFORT=medium

# ── Voz con IA (Vapi) ────────────────────────────────────────
# Telefonía + voz a texto + texto a voz. El LLM lo pone este servidor.
VAPI_API_KEY=
# Secreto compartido para firmar las URLs de webhook y del LLM personalizado.
# Genera uno con: openssl rand -hex 32
VAPI_WEBHOOK_SECRET=
# Clave pública de Vapi para llamadas web desde el navegador (opcional).
NEXT_PUBLIC_VAPI_PUBLIC_KEY=

# ── Pagos (Stripe) ───────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# IDs de precios recurrentes (mensuales) creados en tu cuenta de Stripe
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# Días de prueba gratis para nuevas inmobiliarias
TRIAL_DAYS=14
